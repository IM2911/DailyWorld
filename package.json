    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "wrangler": "^4.160.1"
